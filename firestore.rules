rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/sales_users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserStoreId() {
      return getUserData().storeId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SuperAdmin';
    }

    function belongsToStore(storeId) {
      return isAuthenticated() && (getUserStoreId() == storeId || isSuperAdmin());
    }

    // 1. Sales Users collection rules
    match /sales_users/{userId} {
      allow read: if isAuthenticated();
      // Allow self-registration or SuperAdmin update
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        getUserRole() == 'Director' || 
        getUserRole() == 'Team Leader'
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Products collection rules
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 3. Store-scoped collections (Tenant Isolation)
    match /stores/{storeId}/{document=**} {
      allow read, write: if belongsToStore(storeId);
    }

    // 4. Shared legacy/top-level collections (enforce storeId check for isolation)
    match /sales_transactions/{txId} {
      allow read: if isAuthenticated() && (belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if isAuthenticated() && belongsToStore(request.resource.data.storeId);
      allow update: if isAuthenticated() && belongsToStore(resource.data.storeId);
      allow delete: if isSuperAdmin();
    }

    match /commissions/{commId} {
      allow read: if isAuthenticated() && (belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if isAuthenticated() && belongsToStore(request.resource.data.storeId);
      allow update: if isAuthenticated() && belongsToStore(resource.data.storeId);
      allow delete: if isSuperAdmin();
    }

    match /customers/{custId} {
      allow read: if isAuthenticated() && (belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if isAuthenticated() && belongsToStore(request.resource.data.storeId);
      allow update: if isAuthenticated() && belongsToStore(resource.data.storeId);
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expId} {
      // Expenses are user-scoped or manager-approved
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        getUserRole() == 'Team Leader' || 
        getUserRole() == 'Director' || 
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        getUserRole() == 'Team Leader' || 
        getUserRole() == 'Director' || 
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /quotations/{qId} {
      allow read: if isAuthenticated() && (belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if isAuthenticated() && belongsToStore(request.resource.data.storeId);
      allow update: if isAuthenticated() && belongsToStore(resource.data.storeId);
      allow delete: if isAuthenticated() && belongsToStore(resource.data.storeId);
    }

    match /system_settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
